---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../../site.config.json';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  ogImage?: string;
}

const { title, description, lang, ogImage } = Astro.props;
const t = useTranslations(lang);
const isFr = lang === 'fr';

const pageTitle = title 
  ? `${title} — ${siteConfig.artist.name}`
  : `${siteConfig.artist.name} — ${isFr ? siteConfig.artist.title.fr : siteConfig.artist.title.en}`;

const pageDesc = description || (isFr ? siteConfig.artist.tagline.fr : siteConfig.artist.tagline.en);

const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteConfig.siteUrl).href;
const enUrl = new URL(pathname.replace(/^\/fr/, '') || '/', siteConfig.siteUrl).href;
const frUrl = new URL(`/fr${pathname.replace(/^\/fr/, '')}`.replace(/\/fr\/$/, '/fr'), siteConfig.siteUrl).href;
const socialImage = ogImage ? new URL(ogImage, siteConfig.siteUrl).href : `${siteConfig.siteUrl}/images/roddy-agbo.jpg`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fr" href={frUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={isFr ? "fr_FR" : "en_US"} />
    <meta property="og:site_name" content={siteConfig.artist.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" 
      rel="stylesheet" 
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {t('a11y.skipToContent')}
    </a>

    <Header lang={lang} currentPath={pathname} />

    <main id="main-content">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
