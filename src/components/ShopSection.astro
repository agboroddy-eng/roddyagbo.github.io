---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import ShopPreviewCard from './ShopPreviewCard.astro';

interface Props {
  products: any[];
  lang: Lang;
}

const { products, lang } = Astro.props;
const t = useTranslations(lang);
const isFr = lang === 'fr';

const featuredProducts = products
  .filter((p) => p.data.featured && p.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

{featuredProducts.length > 0 && (
  <section class="shop-strip" aria-labelledby="shop-strip-heading">
    <div class="container">
      <div class="shop-strip-header">
        <div class="header-text">
          <h2 id="shop-strip-heading" class="section-title">{t('shopSection.title')}</h2>
          <p class="section-subtitle">{t('shopSection.subtitle')}</p>
        </div>
        <a href={isFr ? '/fr/shop' : '/shop'} class="shop-link">
          {t('shopSection.viewAll')} &rarr;
        </a>
      </div>

      <div class="shop-grid">
        {featuredProducts.map((p) => (
          <ShopPreviewCard product={p.data} lang={lang} />
        ))}
      </div>

      <p class="currency-notice">
        {t('shopSection.currencyNotice')}
      </p>
    </div>
  </section>
)}

<style>
  .shop-strip {
    padding-top: 5rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  .shop-strip-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .shop-strip-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-subtitle {
    font-size: 0.92rem;
    color: var(--color-muted);
  }

  .shop-link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    transition: transform var(--transition-fast);
    align-self: flex-start;
  }

  .shop-link:hover {
    transform: translateX(3px);
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2rem;
  }

  @media (min-width: 600px) {
    .shop-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .shop-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .currency-notice {
    margin-top: 2rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    font-style: italic;
  }
</style>
