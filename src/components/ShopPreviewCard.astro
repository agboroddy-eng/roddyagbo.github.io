---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';

interface Props {
  product: {
    slug: string;
    title: { en: string; fr: string };
    type: string;
    categories: string[];
    availability: string;
    variants: Array<{
      name: { en: string; fr: string };
      priceXof: number | string;
    }>;
    images: Array<{
      src: string;
      alt: { en: string; fr: string };
      width: number;
      height: number;
    }>;
  };
  lang: Lang;
}

const { product, lang } = Astro.props;
const t = useTranslations(lang);
const isFr = lang === 'fr';

const primaryImage = product.images[0] || {
  src: '/images/products/placeholder.svg',
  alt: { en: 'Product visual', fr: 'Visuel du produit' },
  width: 800,
  height: 800
};

const productUrl = isFr ? `/fr/shop/${product.slug}` : `/shop/${product.slug}`;

const firstVariant = product.variants[0];
const rawPrice = firstVariant ? firstVariant.priceXof : '[À REMPLIR]';
const hasMultipleVariants = product.variants.length > 1;

let displayPrice = '';
if (typeof rawPrice === 'number') {
  displayPrice = `${rawPrice.toLocaleString('fr-FR')} FCFA`;
} else {
  displayPrice = `${rawPrice} FCFA`;
}

const badgeLabelKey = ({
  'available': 'badges.available',
  'coming-soon': 'badges.comingSoon',
  'pre-order': 'badges.preOrder',
  'unavailable': 'badges.unavailable',
  'sold': 'badges.sold',
  'limited': 'badges.limited'
} as any)[product.availability] || 'badges.comingSoon';
---

<div class="shop-card">
  <a href={productUrl} class="product-link">
    <div class="media-container" style={`aspect-ratio: ${primaryImage.width} / ${primaryImage.height};`}>
      <img 
        src={primaryImage.src} 
        alt={isFr ? primaryImage.alt.fr : primaryImage.alt.en} 
        width={primaryImage.width} 
        height={primaryImage.height} 
        loading="lazy" 
        decoding="async"
        class="product-img"
      />
      <div class="badge-wrapper">
        <span class:list={['status-badge', product.availability]}>
          {t(badgeLabelKey)}
        </span>
      </div>
    </div>

    <div class="product-info">
      <div class="type-tag">{product.type.toUpperCase()}</div>
      <h3 class="product-title">{isFr ? product.title.fr : product.title.en}</h3>
      <p class="product-price">
        {hasMultipleVariants && <span class="prefix">{t('shopSection.startingFrom')} </span>}
        <span class="amount">{displayPrice}</span>
      </p>
    </div>
  </a>
</div>

<style>
  .shop-card {
    display: flex;
    flex-direction: column;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: inherit;
  }

  .media-container {
    position: relative;
    width: 100%;
    background-color: var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--transition-fast);
  }

  .product-link:hover .product-img {
    transform: scale(1.02);
  }

  .badge-wrapper {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .type-tag {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    font-weight: 500;
  }

  .product-title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text);
  }

  .product-price {
    font-size: 0.88rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .product-price .prefix {
    color: var(--color-muted);
    font-size: 0.82rem;
  }
</style>
