---
import Layout from '../../layouts/Layout.astro';
const lang = 'fr';
---

<Layout title="404 — Page introuvable" description="La page demandée n'existe pas." lang={lang}>
  <div class="container not-found-page">
    <div class="not-found-content">
      <span class="error-code">404</span>
      <h1 class="error-title">Page introuvable</h1>
      <p class="error-text">L'œuvre ou la page que vous recherchez a été déplacée ou n'existe pas.</p>
      <div class="actions">
        <a href="/fr" class="btn-home">&larr; Revenir à la galerie</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .not-found-content {
    max-width: 500px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .error-code {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-muted);
    letter-spacing: 0.1em;
  }
  .error-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
  }
  .error-text {
    font-size: 1.05rem;
    color: var(--color-muted);
  }
  .actions {
    margin-top: 1rem;
  }
  .btn-home {
    display: inline-block;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.85rem 1.6rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }
</style>
